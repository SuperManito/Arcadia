{
  "name": "arcadia",
  "type": "module",
  "version": "1.0.0",
  "description": "arcadia",
  "engines": {
    "node": ">=20.0"
  },
  "scripts": {
    "server": "prisma generate && echo 'y' | prisma db push --accept-data-loss > ./prisma_push.log && tsx index",
    "build": "tsc",
    "tsc": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:dev": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "generate": "prisma generate",
    "clean": "rimraf dist && rimraf package-lock.json && rimraf node_modules"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "ansi-regex": "6.4.0",
    "archiver": "8.0.0",
    "axios": "1.21.0",
    "better-sse": "0.16.1",
    "body-parser": "2.4.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "cron": "4.4.0",
    "express": "5.3.0",
    "express-jwt": "8.5.1",
    "jsonwebtoken": "9.0.3",
    "lemon-captcha": "0.1.2",
    "log4js": "6.9.1",
    "multer": "2.5.0",
    "node-pty": "1.1.0",
    "otpauth": "9.5.2",
    "pm2": "7.1.1",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prisma": "7.10.1",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "esbuild": true,
    "node-pty": true,
    "prisma": true
  }
}
